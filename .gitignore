# Ignore a specific file
secret_config.json

# Ignore an entire folder (always end with a slash)
ignore/

# Ignore all files with a specific extension
*.log
*.tmp

# Ignore all .log files inside a specific folder
logs/*.log

# Ignore a file in the root directory, but NOT in subdirectories
/config.txt

# Ignore everything in a folder EXCEPT a specific file
build/*
!build/keep_this.txt
